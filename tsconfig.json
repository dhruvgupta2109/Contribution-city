{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "resolveJsonModule": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "api", "server", "tests", "vite.config.ts"]
}
