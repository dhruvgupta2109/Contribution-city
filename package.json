{
  "name": "contribution-city",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "predev": "node scripts/build-source.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/build-source.mjs && vite build",
    "build:sites": "npm run typecheck && node scripts/build-source.mjs && vite build --outDir .site-client && node scripts/build-sites.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
